# Copy to .env and fill in — .env is git-ignored, never commit real keys.
#
# Only the provider you actually use needs a value. The key is read from the
# environment, so nothing secret ever has to touch the command line, the report
# files, or the repository.

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Tencent tokenhub (hy-mt2-lite and friends) — https://tokenhub.tencentmaas.com/
TOKENHUB_API_KEY=

# SiliconFlow — https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=

# Any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local HuggingFace model: use a mirror when huggingface.co is slow or blocked.
# HF_ENDPOINT=https://hf-mirror.com

# Keep large weights out of the repo (this path is git-ignored).
# HF_HOME=./models
