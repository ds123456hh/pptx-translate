# Normalise line endings so the repo behaves the same on Windows, macOS and Linux.
* text=auto eol=lf

# Windows PowerShell scripts must keep CRLF for maximum compatibility.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary-ish assets that must never be text-normalised.
*.pptx binary
*.pptm binary
*.gguf binary
*.png binary
*.jpg binary
*.safetensors binary

# Keep diffs readable in review tooling.
*.md text
*.py text
*.toml text
*.yml text

# Generated files: do not count them in language stats.
*.report.json linguist-generated=true
